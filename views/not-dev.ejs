<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>En cour de développement</title>
    <link rel="stylesheet" href="/css/simple_page.css">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/header.css">
    <script defer src="https://statistiques.nathanaelle.org/script.js" data-website-id="41060079-f328-4d6e-a6c2-29ce093380d2"></script>
    <script defer src="https://statistiques.nathanaelle.org/recorder.js" data-website-id="41060079-f328-4d6e-a6c2-29ce093380d2"></script>
    <style>
        .wheel {
            width: 120px;
            animation: spin 5s linear infinite;
        }

        @keyframes spin {
            from { transform: rotate(0deg) }
            to   { transform: rotate(360deg) }
        }
    </style>
</head>
<%- include('partials/header') %>
<body>
    <div class="center">
        <h1 id="title" style="font-size: 2rem;align-items: center;display: flex;">Page en cours de développement</h1>
        <img class="wheel" src="https://unpkg.com/simple-icons@v16/icons/devbox.svg" />
        <br>
        <a class="button" onclick="history.back()">Retour</a>
    </div>
</body>
</html>
